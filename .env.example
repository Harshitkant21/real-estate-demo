# =================================================================
# MITTAL & CO. PLATFORM ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Senior Advisor WhatsApp Referral Number (Full international format with country code, no leading +)
# Examples: 
#   For India (+91):  919876543210
#   For UAE (+971):   971501234567
VITE_ADVISOR_WHATSAPP=971501234567

# 2. Senior Advisor Email Address (Receives booking & EOI submissions)
VITE_ADVISOR_EMAIL=advisory@mittalco.com

# 3. AI Intelligence Provider (options: 'nvidia' | 'mistral')
VITE_AI_PROVIDER=nvidia

# 4. AI Model Choice
VITE_AI_MODEL=meta/llama-3.1-8b-instruct

# 5. AI API Base Proxy URL
VITE_AI_BASE_URL=/api/nvidia/v1/chat/completions

# 6. NVIDIA NIM / AI API Key
NVIDIA_API_KEY=your_nvidia_api_key_here

# 7. Property Finder RapidAPI Credentials
# Get key from https://rapidapi.com/ (property-finder6)
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_HOST=property-finder6.p.rapidapi.com
