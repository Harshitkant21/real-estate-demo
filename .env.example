# =================================================================
# MITTALCO PLATFORM ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Senior Advisor WhatsApp Referral Number (E.164 format without +)
# How to get: Use your registered WhatsApp Business number for advisor chats.
# Example: 971501234567
VITE_ADVISOR_WHATSAPP=971501234567

# 2. AI Intelligence Provider (options: 'nvidia' | 'mistral')
# How to select: Choose 'nvidia' for NVIDIA NIM API or 'mistral' for Mistral AI.
VITE_AI_PROVIDER=nvidia

# 3. AI Model Choice
# For NVIDIA NIM: meta/llama-3.1-8b-instruct or nvidia/llama-3.1-nemotron-70b-instruct
# For Mistral AI: mistral-tiny or mistral-small-latest
VITE_AI_MODEL=meta/llama-3.1-8b-instruct

# 4. AI API Base Proxy URL
# Proxied via Vite dev server / Edge handler to bypass CORS
VITE_AI_BASE_URL=/api/nvidia/v1/chat/completions

# 5. NVIDIA NIM / AI API Key
# How to get NVIDIA NIM Key:
#   1. Sign up at https://build.nvidia.com/
#   2. Generate an API Key starting with nvapi-...
#   3. Paste key below. Secrets remain proxy-handled and client-safe.
VITE_NVIDIA_API_KEY=nvapi-your-key-here
